      padding-bottom: 4pt;
      margin-top: 18pt;
      margin-bottom: 8pt;
      page-break-after: avoid;
    }
    h3 {
      font-size: 12pt;
      font-weight: 700;
      color: #1e3a8a;
      margin-top: 14pt;
      margin-bottom: 6pt;
      page-break-after: avoid;
    }
