      font-size: 9.5pt;
      page-break-inside: avoid;
    }
    th, td {
      border: 1pt solid #cbd5e1;
      padding: 6pt 8pt;
      text-align: left;
      vertical-align: top;
    }
    th {
      background-color: #f1f5f9;
      font-weight: 700;
      color: #0B1D3A;
    }
    tr:nth-child(even) td {
      background-color: #f8fafc;
    }
    pre {
      background: #0B1D3A;
      color: #f8fafc;
      padding: 10pt;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 9pt;
      border-radius: 4pt;
      overflow-x: auto;
      line-height: 1.4;
      margin: 8pt 0;
    }
    code {
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 9pt;
      background: #f1f5f9;
      padding: 1.5pt 3pt;
      border-radius: 2pt;
      color: #0f172a;
    }
    pre code {
      background: transparent;
      padding: 0;
      color: inherit;
    }
    blockquote {
      border-left: 3.5pt solid #2563EB;
      margin: 8pt 0 10pt 0;
      padding: 6pt 12pt;
      background: #eff6ff;
      color: #1e3a8a;
      font-size: 10pt;
      border-radius: 0 4pt 4pt 0;
    }
    hr {
      border: 0;
      border-top: 1pt solid #e2e8f0;
      margin: 16pt 0;
    }
